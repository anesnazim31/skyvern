# Skyvern local/self-hosted deployment template
# Copy to .env and fill secrets on the target host. Never commit .env.
ENV=local
BROWSER_STREAMING_MODE=cdp
BROWSER_TYPE=chromium-headless
PORT=8000
ANALYTICS_ID=anonymous
ENABLE_LOG_ARTIFACTS=false

# PostgreSQL connection. Use a secret-managed password on the target host.
DATABASE_STRING="postgresql+psycopg://skyvern:CHANGE_ME@localhost/skyvern"

# Enable exactly one provider and set its key on the target host.
ENABLE_OPENAI=false
OPENAI_API_KEY=""
ENABLE_ANTHROPIC=false
ANTHROPIC_API_KEY=""
ENABLE_XAI=false
XAI_API_KEY=""
ENABLE_GEMINI=false
GEMINI_API_KEY=""

# Local API/MCP authentication key; generate a new value on the target host.
SKYVERN_API_KEY="CHANGE_ME"
